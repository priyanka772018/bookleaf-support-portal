# --- Required in production ---
DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5432/bookleaf
JWT_SECRET=replace-with-a-long-random-string

# --- AI (server-side only; never exposed to the browser) ---
# Set ONE of the two keys. With neither, the app runs on keyword triage + policy-template drafts.
# AI_PROVIDER is inferred from the key; set it explicitly (anthropic | gemini | disabled) to override.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Google Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# USD per million tokens, only used for the cost estimate in the admin AI-usage panel
AI_INPUT_COST_PER_MTOK=0.10
AI_OUTPUT_COST_PER_MTOK=0.50

# --- Optional ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_SSL=false
TEST_DATABASE_URL=postgres://bookleaf:bookleaf@localhost:5432/bookleaf_test
# AUTO_MIGRATE=false   # skip migrate+seed on boot
